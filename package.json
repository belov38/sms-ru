{
  "name": "@belov.ai/sms-ru",
  "version": "0.2.0",
  "description": "Библиотека для отправки sms через sms.ru используя нативный nodejs fetch()",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sms-ru": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belov38/sms-ru.git"
  },
  "keywords": [
    "sms",
    "sms.ru"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Ilia Belov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/belov38/sms-ru/issues"
  },
  "homepage": "https://github.com/belov38/sms-ru#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
